IMAGE_REPO=registry.gitlab.com/dmr4013905/techarchitecture/techarchitecture/streammux
TAG=latest
# OneLab / local dev default (PLAINTEXT). Production uses Rednet PNR Kafka — see
# devops/inventory/group_vars/kafka_streams/streammux.yml (kb101–kb105 :9095, SASL_SSL).
KAFKA_BOOTSTRAP_SERVERS=techarch-kafka1.srv.lab.bthpny.alticeusa.net:9092
# Production only (SASL_SSL :9095). SASL password in kafka_streams/vault.yml.
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# JVM only (job-management-api, site-orchestrator). Node catalog-api uses KAFKA_SSL_REJECT_UNAUTHORIZED.
KAFKA_SSL_ENGINE_FACTORY_CLASS=io.github.guillebot.streammux.contracts.kafka.TrustAllSslEngineFactory
KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=
KAFKA_SSL_REJECT_UNAUTHORIZED=false
# Optional bake-time default for the web-ui "New job" template field
# (routeAppConfig.streamProperties.bootstrap.servers). Vite inlines this into
# the JS bundle at build time, so anything set here ships in the published
# image — leave EMPTY when building images that may be pulled outside the lab.
# Used by docker-compose.dev.yml and build_and_push.sh; for local
# `npm run dev` / `npm run build`, set in web-ui/.env instead.
VITE_EXAMPLE_KAFKA_BOOTSTRAP=
JOB_MANAGEMENT_API_PORT=8080
STREAMMUX_API_USERNAME=streammux
STREAMMUX_API_PASSWORD=change-me-now
STREAMMUX_WEB_PORT=8088
STREAMMUX_SITE_ID=site-a
STREAMMUX_INSTANCE_ID=orchestrator-1
STREAMMUX_TOPIC_JOB_DEFINITIONS=net.optimum.experimental.streamlens.streammux.jobdefinitions
STREAMMUX_TOPIC_JOB_LEASES=net.optimum.experimental.streamlens.streammux.jobleases
STREAMMUX_TOPIC_JOB_STATUS=net.optimum.experimental.streamlens.streammux.jobstatus
STREAMMUX_TOPIC_JOB_EVENTS=net.optimum.experimental.streamlens.streammux.jobevents
STREAMMUX_TOPIC_JOB_COMMANDS=net.optimum.experimental.streamlens.streammux.jobcommands
# Compacted topic backing the job catalog API (key = catalog row id, value = JSON row, null = delete).
STREAMMUX_TOPIC_JOB_CATALOG=net.optimum.experimental.streamlens.streammux.jobcatalog
# Optional exact input allowlist (comma-separated). Prefix allowlist below is the primary prod lock.
STREAMMUX_ALLOWED_INPUT_TOPICS=
# LOCKED prod input allowlist prefixes — com.optimum., net.optimum., gcp.optimum.
# OneLab Ansible also allows lab.optimum.; do not add other prefixes without operator approval.
STREAMMUX_ALLOWED_INPUT_TOPIC_PREFIXES=com.optimum.,net.optimum.,gcp.optimum.
STREAMMUX_ALLOWED_OUTPUT_TOPICS=
# LOCKED prod output allowlist prefix — Rednet data plane (NOT the app/control-plane topic prefix above).
STREAMMUX_ALLOWED_OUTPUT_TOPIC_PREFIXES=net.optimum.

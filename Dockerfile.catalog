ARG DOCKER_HUB_PROXY=
FROM ${DOCKER_HUB_PROXY}node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3

WORKDIR /app

COPY --chown=node:node job-catalog-api/package.json job-catalog-api/package-lock.json ./
RUN npm ci --omit=dev

COPY --chown=node:node job-catalog-api/server.mjs job-catalog-api/kafka-config.mjs ./

ENV PORT=3000
ENV JOB_MANAGEMENT_API_URL=http://job-management-api:8080

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

USER node

CMD ["node", "server.mjs"]

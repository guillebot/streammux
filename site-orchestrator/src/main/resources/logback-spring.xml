<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="app"/>
    <springProperty scope="context" name="siteId" source="streammux.site.site-id" defaultValue=""/>
    <springProperty scope="context" name="instanceId" source="streammux.site.instance-id" defaultValue=""/>

    <springProfile name="default,dev,test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} [%thread] %-5level %logger{36} siteId=%X{siteId:-${siteId}} instanceId=%X{instanceId:-${instanceId}} jobId=%X{jobId:-} action=%X{action:-} - %msg%n%throwable</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp>
                        <fieldName>@timestamp</fieldName>
                    </timestamp>
                    <version/>
                    <pattern>
                        <pattern>
                            {
                              "service": "${appName}",
                              "siteId": "%X{siteId:-${siteId}}",
                              "instanceId": "%X{instanceId:-${instanceId}}",
                              "jobId": "%X{jobId:-}",
                              "action": "%X{action:-}",
                              "thread": "%thread",
                              "logger": "%logger",
                              "level": "%level"
                            }
                        </pattern>
                    </pattern>
                    <message/>
                    <stackTrace>
                        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                            <maxDepthPerThrowable>30</maxDepthPerThrowable>
                            <rootCauseFirst>true</rootCauseFirst>
                        </throwableConverter>
                    </stackTrace>
                    <mdc>
                        <excludeMdcKeyName>siteId</excludeMdcKeyName>
                        <excludeMdcKeyName>instanceId</excludeMdcKeyName>
                        <excludeMdcKeyName>jobId</excludeMdcKeyName>
                        <excludeMdcKeyName>action</excludeMdcKeyName>
                    </mdc>
                </providers>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>

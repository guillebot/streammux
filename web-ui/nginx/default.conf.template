server {
    listen 80;
    server_name localhost;
    # Traefik forwards the browser .onelab.alticeusa.net cookie jar (Authelia session + app cookies).
    client_header_buffer_size 16k;
    large_client_header_buffers 8 32k;
    root /usr/share/nginx/html;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    gzip on;

    # Defer upstream resolution so nginx -t / container start works without the API on /etc/hosts.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /jobs {
        set $streammux_api http://${STREAMMUX_JOB_MANAGEMENT_API};
        proxy_pass $streammux_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "Basic ${STREAMMUX_API_BASIC_AUTH}";
    }

    location /swagger-ui {
        set $streammux_api http://${STREAMMUX_JOB_MANAGEMENT_API};
        proxy_pass $streammux_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "Basic ${STREAMMUX_API_BASIC_AUTH}";
    }

    location /v3/api-docs {
        set $streammux_api http://${STREAMMUX_JOB_MANAGEMENT_API};
        proxy_pass $streammux_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "Basic ${STREAMMUX_API_BASIC_AUTH}";
    }

    # Proxy only job-catalog-api REST paths. React routes also live under /catalog
    # (/catalog, /catalog/items/*) and must fall through to index.html.
    location ~ ^/catalog/(entries|health|settings) {
        set $catalog_upstream http://${STREAMMUX_JOB_CATALOG_API};
        proxy_pass $catalog_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

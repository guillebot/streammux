server {
    listen 80;
    server_name localhost;
    # Traefik forwards the browser .onelab.alticeusa.net cookie jar (Authelia session + app cookies).
    client_header_buffer_size 16k;
    large_client_header_buffers 8 32k;
    root /usr/share/nginx/html;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    gzip on;

    # Defer upstream resolution so nginx -t / container start works without the API on /etc/hosts.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /jobs {
        set $streammux_api http://${STREAMMUX_JOB_MANAGEMENT_API};
        proxy_pass $streammux_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Remote-User $http_remote_user;
        proxy_set_header Remote-Email $http_remote_email;
        proxy_set_header Remote-Name $http_remote_name;
        proxy_set_header Remote-Groups $http_remote_groups;
        #__STREAMMUX_JOBS_AUTH__
    }

    location /activity {
        set $streammux_api http://${STREAMMUX_JOB_MANAGEMENT_API};
        proxy_pass $streammux_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Remote-User $http_remote_user;
        proxy_set_header Remote-Email $http_remote_email;
        proxy_set_header Remote-Name $http_remote_name;
        proxy_set_header Remote-Groups $http_remote_groups;
        #__STREAMMUX_JOBS_AUTH__
    }

    location /swagger-ui {
        set $streammux_api http://${STREAMMUX_JOB_MANAGEMENT_API};
        proxy_pass $streammux_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        #__STREAMMUX_JOBS_AUTH__
    }

    location /v3/api-docs {
        set $streammux_api http://${STREAMMUX_JOB_MANAGEMENT_API};
        proxy_pass $streammux_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        #__STREAMMUX_JOBS_AUTH__
    }

    # Proxy only job-catalog-api REST paths. React routes also live under /catalog
    # (/catalog, /catalog/items/*) and must fall through to index.html.
    location ~ ^/catalog/(entries|health|settings) {
        set $catalog_upstream http://${STREAMMUX_JOB_CATALOG_API};
        proxy_pass $catalog_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /mcp-admin/ {
        set $mcp_upstream http://${STREAMMUX_MCP_API};
        # Variable proxy_pass does not rewrite URI; map /mcp-admin/* → /admin/* explicitly.
        rewrite ^/mcp-admin/(.*)$ /admin/$1 break;
        proxy_pass $mcp_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Streammux-Mcp-Admin 1;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
